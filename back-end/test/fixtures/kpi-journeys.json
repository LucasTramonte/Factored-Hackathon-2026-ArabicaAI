{
  "description": "Authored journeys for the dispute-manager KPI instrumentation test (kpi-instrumentation.test.js). Fictitious demo customers only; kpi_seed.sql adds three bank-flagged charges for demo-carla. Phase 1 runs, then one idle sweep 11 minutes ahead closes its starts, then phase 2. Every expected value was counted by hand from the journeys; \"from_events\" marks a wall-clock duration, which the test takes from the episode scorer (evals/intake/episodes.py) and requires the store to equal. The test tests the measurement, not the customers.",
  "journeys": [
    {
      "id": "J05",
      "phase": 1,
      "customer": "demo-marco",
      "language": "pt",
      "story": "Starts a report and leaves; the idle sweep closes it.",
      "steps": [
        {
          "do": "start"
        },
        {
          "do": "idle"
        }
      ]
    },
    {
      "id": "J06",
