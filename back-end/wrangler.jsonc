{
  "name": "factored-hackathon-2026-arabicaai",
  "main": "src/index.js",
  "compatibility_date": "2026-09-28",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/index.html", "/agent", "/healthz", "/demo/*", "/auth", "/auth/*", "/agent/*", "/transactions", "/transactions/*", "/cases", "/cases/*", "/intake", "/intake/*", "/reports", "/reports/*"],
    "not_found_handling": "single-page-application"
  },
  "placement": { "mode": "smart" },
  "vars": {
    "COGNITO_REGION": "us-east-2",
    "COGNITO_USER_POOL_ID": "us-east-2_Lo7KrT6MT",
    "COGNITO_CLIENT_ID": "5ak5cbjgdddso1c3h3i2aha7sn",
    "SES_REGION": "us-east-2",
    "SES_FROM": "ArabicaAI demo <rzuniga@aptsny.co>"
  },
  "observability": {
    "logs": { "enabled": true, "head_sampling_rate": 1, "invocation_logs": true, "persist": true },
    "traces": { "enabled": true, "head_sampling_rate": 1, "persist": true }
  },
  "ratelimits": [
    { "name": "API_LIMIT", "namespace_id": "1001", "simple": { "limit": 60, "period": 60 } }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "arabica-intake-demo",
      "database_id": "befa35e6-e735-4757-89b1-b4f82fdca20d",
      "migrations_dir": "migrations"
    }
  ]
}
