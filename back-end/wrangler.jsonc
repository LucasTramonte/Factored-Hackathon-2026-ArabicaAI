{
  "name": "factored-hackathon-2026-arabicaai",
  "main": "src/index.js",
  "compatibility_date": "2026-09-28",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/healthz", "/demo/*", "/agent/*", "/transactions", "/transactions/*", "/cases", "/cases/*"],
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "arabica-intake-demo",
      "database_id": "befa35e6-e735-4757-89b1-b4f82fdca20d",
      "migrations_dir": "migrations"
    }
  ]
}
