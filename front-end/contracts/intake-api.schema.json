{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "intake-api.schema.json",
  "title": "Intake API response contracts",
  "description": "Response bodies the Angular client relies on. back-end/test validates every integration-test response against these definitions, so a change here and in the Worker must land together.",
  "$defs": {
    "intakeStart": {
      "type": "object",
      "additionalProperties": false,
      "required": ["episode_id", "state", "language", "mode", "replayed"],
      "properties": {
        "episode_id": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
        "state": { "const": "selection_required" },
        "language": { "type": "string", "pattern": "^(es|pt)$" },
        "mode": { "const": "guided" },
        "replayed": { "type": "boolean" }
      }
    },
    "intakeReceipt": {
      "type": "object", "additionalProperties": false,
      "required": ["episode_id", "protocol", "kind", "accepted_at", "replayed", "next_step_code"],
      "properties": {
        "episode_id": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
        "protocol": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
        "kind": { "type": "string", "pattern": "^(complete|technical|incomplete)$" },
        "accepted_at": { "type": "string", "minLength": 1 },
        "replayed": { "type": "boolean" },
        "next_step_code": { "const": "await_human_review" }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "detail"
      ],
      "properties": {
        "detail": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "health": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "const": "ok"
        }
      }
    },
    "customerSession": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "customer_id",
        "mode"
      ],
      "properties": {
        "customer_id": {
          "type": "string",
          "minLength": 1
        },
        "mode": {
          "const": "simulated_login"
        },
        "context_card": {
          "type": ["object", "null"],
          "description": "Snapshot prepared by the quality-gated load; locale_hint never overrides session language.",
          "additionalProperties": false,
          "required": ["version", "snapshot_at", "first_name", "locale_hint", "products"],
          "properties": {
            "version": { "const": 1 },
            "snapshot_at": { "type": "string", "minLength": 1 },
            "first_name": { "type": ["string", "null"], "minLength": 1 },
            "locale_hint": { "type": "string", "pattern": "^(es|pt)(-[A-Za-z0-9]+)*$" },
            "products": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["product_type", "last4", "currency"],
                "properties": {
                  "product_type": { "type": ["string", "null"] },
                  "last4": { "type": ["string", "null"], "pattern": "^[0-9]{4}$" },
                  "currency": { "type": ["string", "null"], "pattern": "^[A-Z]{3}$" }
                }
              }
            }
          }
        }
      }
    },
    "agentSession": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "mode"
      ],
      "properties": {
        "role": {
          "const": "agent"
        },
        "mode": {
          "const": "simulated_login"
        }
      }
    },
    "transaction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "transaction_id",
        "occurred_at",
        "source_occurred_at",
        "merchant_name",
        "amount",
        "currency"
      ],
      "properties": {
        "transaction_id": {
          "type": "string",
          "minLength": 1
        },
        "occurred_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_occurred_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "merchant_name": {
          "type": "string"
        },
        "amount": {
          "type": "string",
          "pattern": "^[0-9]+(\\.[0-9]{1,2})?$"
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        }
      }
    },
    "transactionList": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "items",
        "has_more",
        "coverage"
      ],
      "properties": {
        "items": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "$ref": "#/$defs/transaction"
          }
        },
        "has_more": {
          "type": "boolean"
        },
        "coverage": {
          "type": "string",
          "pattern": "^(fictitious_demo_data_only|dataset_cohort)$"
        }
      }
    },
    "caseReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol",
        "transaction_id",
        "status",
        "accepted_at",
        "replayed",
        "scope",
        "next_step"
      ],
      "properties": {
        "protocol": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "transaction_id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "const": "accepted"
        },
        "accepted_at": {
          "type": "string",
          "minLength": 1
        },
        "replayed": {
          "type": "boolean"
        },
        "scope": {
          "const": "synthetic_demo_only"
        },
        "next_step": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "agentCase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol",
        "customer_id",
        "display_name",
        "transaction_id",
        "merchant_name",
        "occurred_at",
        "source_occurred_at",
        "amount",
        "currency",
        "customer_statement",
        "customer_confirmed",
        "status",
        "accepted_at"
      ],
      "properties": {
        "protocol": {
          "type": "string",
          "minLength": 1
        },
        "customer_id": {
          "type": "string",
          "minLength": 1
        },
        "display_name": {
          "type": "string"
        },
        "transaction_id": {
          "type": "string",
          "minLength": 1
        },
        "merchant_name": {
          "type": "string"
        },
        "occurred_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_occurred_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "amount": {
          "type": "string"
        },
        "currency": {
          "type": "string"
        },
        "customer_statement": {
          "type": "string",
          "minLength": 10,
          "maxLength": 2000
        },
        "customer_confirmed": {
          "const": true
        },
        "status": {
          "const": "accepted"
        },
        "accepted_at": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "agentCaseList": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "items",
        "has_more",
        "scope"
      ],
      "properties": {
        "items": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "$ref": "#/$defs/agentCase"
          }
        },
        "has_more": {
          "type": "boolean"
        },
        "scope": {
          "const": "synthetic_demo_only"
        }
      }
    },
    "identityList": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "items"
      ],
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "customer_id",
              "display_name",
              "country"
            ],
            "properties": {
              "customer_id": {
                "type": "string",
                "minLength": 1
              },
              "display_name": {
                "type": "string",
                "minLength": 1
              },
              "country": {
                "type": ["string", "null"]
              }
            }
          }
        }
      }
    },
    "agentIntake": {
      "type": "object", "additionalProperties": false,
      "required": ["protocol", "episode_id", "kind", "tool_status", "destination", "priority", "accepted_at"],
      "properties": {
        "protocol": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
        "episode_id": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
        "kind": {"type": "string", "pattern": "^(complete|technical|incomplete)$"},
        "tool_status": {"type": "string", "pattern": "^(ok|failed|timeout)$"},
        "destination": {"type": "string", "minLength": 1},
        "priority": {"type": "string", "minLength": 1},
        "accepted_at": {"type": "string", "minLength": 1}
      }
    },
    "agentIntakeList": {
      "type": "object", "additionalProperties": false,
      "required": ["items", "has_more", "scope"],
      "properties": {
        "items": {"type": "array", "maxItems": 50, "items": {"$ref": "#/$defs/agentIntake"}},
        "has_more": {"type": "boolean"},
        "scope": {"const": "synthetic_demo_only"}
      }
    },
    "intakeServiceTransition": {
      "type": "object", "additionalProperties": false,
      "required": ["seq", "event", "ts"],
      "properties": {
        "seq": {"type": "integer"},
        "event": {"type": "string", "pattern": "^(intake_started|clarification_requested|transaction_confirmed|handoff_created|handoff_accepted|intake_ended)$"},
        "ts": {"type": "string", "minLength": 1},
        "transaction_ref": {"type": "string", "minLength": 1},
        "case_ref": {"type": "string", "minLength": 1},
        "kind": {"type": "string", "pattern": "^(complete|technical|incomplete)$"},
        "tool_status": {"type": "string", "pattern": "^(ok|failed|timeout)$"},
        "accepted_by": {"type": "string", "minLength": 1},
        "outcome": {"type": "string", "pattern": "^(accepted|abandoned|withdrawn|technical_failure|routed)$"},
        "missing": {"type": "array", "items": {"type": "string", "pattern": "^(date|currency|amount|matching_transaction|transaction_disambiguation|customer_confirmation|valid_customer_confirmation)$"}}
      }
    },
    "agentIntakeDetail": {
      "type": "object", "additionalProperties": false,
      "required": ["protocol", "episode_id", "kind", "tool_status", "destination", "priority", "accepted_at", "language", "customer_statement", "verified_evidence", "actions_taken", "unresolved_questions", "history", "history_has_more", "scope"],
      "properties": {
        "protocol": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
        "episode_id": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
        "kind": {"type": "string", "pattern": "^(complete|technical|incomplete)$"},
        "tool_status": {"type": "string", "pattern": "^(ok|failed|timeout)$"},
        "destination": {"type": "string", "minLength": 1},
        "priority": {"type": "string", "minLength": 1},
        "accepted_at": {"type": "string", "minLength": 1},
        "language": {"type": "string", "pattern": "^(es|pt)$"},
        "customer_statement": {"type": "string", "minLength": 10, "maxLength": 2000},
        "verified_evidence": {"type": "object", "additionalProperties": false, "required": ["transaction"], "properties": {"transaction": {"type": ["object", "null"], "additionalProperties": false, "required": ["transaction_id", "occurred_at", "source_occurred_at", "merchant_name", "amount", "currency"], "properties": {"transaction_id": {"type": "string", "minLength": 1}, "occurred_at": {"type": ["string", "null"]}, "source_occurred_at": {"type": ["string", "null"]}, "merchant_name": {"type": "string"}, "amount": {"type": "string", "pattern": "^[0-9]+(\\.[0-9]{1,2})?$"}, "currency": {"type": "string", "pattern": "^[A-Z]{3}$"}}}}},
        "actions_taken": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "unresolved_questions": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "history": {"type": "array", "maxItems": 100, "items": {"$ref": "#/$defs/intakeServiceTransition"}},
        "history_has_more": {"type": "boolean"},
        "scope": {"const": "synthetic_demo_only"}
      }
    }
  }
}
