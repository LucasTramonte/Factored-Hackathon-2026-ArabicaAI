{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "intake-api.schema.json",
  "title": "Intake API response contracts",
  "description": "Response bodies the Angular client relies on. back-end/test validates every integration-test response against these definitions, so a change here and in the Worker must land together.",
  "$defs": {
    "intakeStart": {
      "type": "object",
      "additionalProperties": false,
      "required": ["episode_id", "state", "language", "mode", "replayed"],
      "properties": {
        "episode_id": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
        "state": { "const": "selection_required" },
        "language": { "type": "string", "pattern": "^(es|pt|en)$" },
        "mode": { "const": "guided" },
        "replayed": { "type": "boolean" }
      }
    },
    "intakeReceipt": {
      "type": "object", "additionalProperties": false,
      "required": ["reference_short", "episode_id", "protocol", "kind", "accepted_at", "replayed", "urgency", "actions_taken", "unresolved_questions", "next_step_code"],
      "properties": {
        "reference_short": { "type": ["string", "null"], "pattern": "^AR-[0-9ABCDEFGHJKMNPQRSTVWXYZ]{4}-[0-9ABCDEFGHJKMNPQRSTVWXYZ]{4}$" },
        "episode_id": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
        "protocol": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
        "kind": { "type": "string", "pattern": "^(complete|technical|incomplete)$" },
        "accepted_at": { "type": "string", "minLength": 1 },
        "replayed": { "type": "boolean" },
        "urgency": { "type": "string", "pattern": "^(normal|high)$" },
        "block_card_line": { "type": "string", "minLength": 1, "description": "Present only when urgency is high: the bank's card-block number (a demo number) for the customer to call; this service never blocks a card." },
        "actions_taken": { "type": "array", "items": { "type": "string", "pattern": "^(owned_transaction_retrieved|customer_confirmation_recorded|transaction_lookup_failed)$" } },
        "unresolved_questions": { "type": "array", "items": { "type": "string", "pattern": "^(matching_transaction|customer_confirmation)$" } },
        "next_step_code": { "const": "await_human_review" }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "detail"
      ],
      "properties": {
        "detail": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "health": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "const": "ok"
        }
      }
    },
    "customerSession": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "customer_id",
        "mode",
        "roles"
      ],
      "properties": {
        "roles": { "type": "array", "maxItems": 4, "items": { "type": "string", "pattern": "^(customer|agent|admin|auditor)$" } },
        "customer_id": {
          "type": "string",
          "minLength": 1
        },
        "mode": {
          "const": "simulated_login"
        },
        "context_card": {
          "type": ["object", "null"],
          "description": "Snapshot prepared by the quality-gated load; locale_hint never overrides session language.",
          "additionalProperties": false,
          "required": ["version", "snapshot_at", "first_name", "locale_hint", "products"],
          "properties": {
            "version": { "const": 1 },
            "snapshot_at": { "type": "string", "minLength": 1 },
            "first_name": { "type": ["string", "null"], "minLength": 1 },
            "locale_hint": { "type": "string", "pattern": "^(es|pt)(-[A-Za-z0-9]+)*$" },
            "products": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["product_type", "last4", "currency"],
                "properties": {
                  "product_type": { "type": ["string", "null"] },
                  "last4": { "type": ["string", "null"], "pattern": "^[0-9]{4}$" },
                  "currency": { "type": ["string", "null"], "pattern": "^[A-Z]{3}$" }
                }
              }
            }
          }
        }
      }
    },
    "emailSession": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "customer_id",
        "mode",
        "roles"
      ],
      "properties": {
        "roles": { "type": "array", "maxItems": 4, "items": { "type": "string", "pattern": "^(customer|agent|admin|auditor)$" } },
        "customer_id": {
          "type": "string",
          "minLength": 1
        },
        "mode": {
          "const": "email_otp"
        },
        "context_card": {
          "type": ["object", "null"],
          "description": "Snapshot prepared by the quality-gated load; locale_hint never overrides session language.",
          "additionalProperties": false,
          "required": ["version", "snapshot_at", "first_name", "locale_hint", "products"],
          "properties": {
            "version": { "const": 1 },
            "snapshot_at": { "type": "string", "minLength": 1 },
            "first_name": { "type": ["string", "null"], "minLength": 1 },
            "locale_hint": { "type": "string", "pattern": "^(es|pt)(-[A-Za-z0-9]+)*$" },
            "products": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["product_type", "last4", "currency"],
                "properties": {
                  "product_type": { "type": ["string", "null"] },
                  "last4": { "type": ["string", "null"], "pattern": "^[0-9]{4}$" },
                  "currency": { "type": ["string", "null"], "pattern": "^[A-Z]{3}$" }
                }
              }
            }
          }
        }
      }
    },
    "agentSession": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "mode",
        "roles"
      ],
      "properties": {
        "roles": { "type": "array", "maxItems": 4, "items": { "type": "string", "pattern": "^(customer|agent|admin|auditor)$" } },
        "role": {
          "const": "agent"
        },
        "mode": {
          "type": "string", "pattern": "^(simulated_login|email_otp)$"
        }
      }
    },
    "transaction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "transaction_id",
        "occurred_at",
        "source_occurred_at",
        "merchant_name",
        "amount",
        "currency"
      ],
      "properties": {
        "transaction_id": {
          "type": "string",
          "minLength": 1
        },
        "occurred_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_occurred_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "merchant_name": {
          "type": "string"
        },
        "amount": {
          "type": "string",
          "pattern": "^[0-9]+(\\.[0-9]{1,2})?$"
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        }
      }
    },
    "transactionList": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "items",
        "has_more",
        "coverage",
        "view_ref"
      ],
      "properties": {
        "items": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "$ref": "#/$defs/transaction"
          }
        },
        "has_more": {
          "type": "boolean"
        },
        "coverage": {
          "type": "string",
          "pattern": "^(fictitious_demo_data_only|dataset_cohort)$"
        },
        "view_ref": {
          "type": ["string", "null"],
          "description": "Random reference of the recorded view when ?lang= was sent (ADR-009); null when nothing was recorded.",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        }
      }
    },
    "chargeViewDisplayed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["view_ref", "displayed_at"],
      "properties": {
        "view_ref": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
        "displayed_at": { "type": "integer", "description": "Epoch milliseconds of the first acknowledgement; a replay keeps it." }
      }
    },
    "caseReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol",
        "transaction_id",
        "status",
        "accepted_at",
        "replayed",
        "scope",
        "next_step"
      ],
      "properties": {
        "protocol": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "transaction_id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "const": "accepted"
        },
        "accepted_at": {
          "type": "string",
          "minLength": 1
        },
        "replayed": {
          "type": "boolean"
        },
        "scope": {
          "const": "synthetic_demo_only"
        },
        "next_step": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "auditEvents": {
      "type": "object", "additionalProperties": false,
      "required": ["auth_events", "auth_events_has_more", "status_changes", "status_changes_has_more", "scope"],
      "properties": {
        "auth_events": { "type": "array", "maxItems": 100, "items": {
          "type": "object", "additionalProperties": false,
          "required": ["id", "ts", "actor", "event", "session_ref", "request_id"],
          "properties": {
            "id": { "type": "integer" },
            "ts": { "type": "integer" },
            "actor": { "type": "string", "pattern": "^(customer|agent)$" },
            "event": { "type": "string", "pattern": "^(session_started|session_rejected|session_expired|logged_out)$" },
            "session_ref": { "type": "string", "pattern": "^[0-9a-f]{12}$" },
            "request_id": { "type": "string", "minLength": 1 } } } },
        "auth_events_has_more": { "type": "boolean" },
        "status_changes": { "type": "array", "maxItems": 100, "items": {
          "type": "object", "additionalProperties": false,
          "required": ["handoff_id", "status", "changed_at", "agent_session_ref"],
          "properties": {
            "handoff_id": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
            "status": { "type": "string", "pattern": "^(in_review|closed)$" },
            "changed_at": { "type": "integer" },
            "agent_session_ref": { "type": "string", "pattern": "^[0-9a-f]{12}$" } } } },
        "status_changes_has_more": { "type": "boolean" },
        "scope": { "const": "references_only" }
      }
    },
    "identityList": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "items"
      ],
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "customer_id",
              "display_name",
              "country"
            ],
            "properties": {
              "customer_id": {
                "type": "string",
                "minLength": 1
              },
              "display_name": {
                "type": "string",
                "minLength": 1
              },
              "country": {
                "type": ["string", "null"]
              }
            }
          }
        }
      }
    },
    "agentIntake": {
      "type": "object", "additionalProperties": false,
      "required": ["reference_short", "protocol", "episode_id", "kind", "status", "tool_status", "destination", "priority", "urgency", "accepted_at", "reason"],
      "properties": {
        "reference_short": { "type": ["string", "null"], "pattern": "^AR-[0-9ABCDEFGHJKMNPQRSTVWXYZ]{4}-[0-9ABCDEFGHJKMNPQRSTVWXYZ]{4}$" },
        "protocol": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
        "episode_id": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
        "kind": {"type": "string", "pattern": "^(complete|technical|incomplete)$"},
        "status": {"type": "string", "pattern": "^(received|in_review|closed)$"},
        "tool_status": {"type": "string", "pattern": "^(ok|failed|timeout)$"},
        "destination": {"type": "string", "minLength": 1},
        "priority": {"type": "string", "minLength": 1},
        "urgency": {"type": "string", "pattern": "^(normal|high)$"},
        "reason": {"type": ["string", "null"], "pattern": "^(not_mine|duplicate|wrong_amount|cancelled_or_not_received|subscription|card_lost_or_stolen|other)$"},
        "accepted_at": {"type": "string", "minLength": 1}
      }
    },
    "agentIntakeList": {
      "type": "object", "additionalProperties": false,
      "required": ["items", "has_more", "scope"],
      "properties": {
        "items": {"type": "array", "maxItems": 50, "items": {"$ref": "#/$defs/agentIntake"}},
        "has_more": {"type": "boolean"},
        "scope": {"const": "synthetic_demo_only"}
      }
    },
    "reportList": {
      "type": "object", "additionalProperties": false,
      "required": ["items", "has_more"],
      "properties": {
        "items": {"type": "array", "maxItems": 20, "items": {
          "type": "object", "additionalProperties": false,
          "required": ["protocol", "reference_short", "kind", "status", "next_step", "accepted_at", "transaction_id"],
          "properties": {
            "protocol": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
            "reference_short": {"type": ["string", "null"], "pattern": "^AR-[0-9ABCDEFGHJKMNPQRSTVWXYZ]{4}-[0-9ABCDEFGHJKMNPQRSTVWXYZ]{4}$"},
            "kind": {"type": "string", "pattern": "^(complete|incomplete|technical)$"},
            "status": {"type": "string", "pattern": "^(received|in_review|closed)$"},
            "next_step": {"type": "string", "pattern": "^(review_pending|being_reviewed|closed_by_person)$"},
            "accepted_at": {"type": "string", "minLength": 1},
            "transaction_id": {"type": ["string", "null"], "minLength": 1}
          }
        }},
        "has_more": {"type": "boolean"}
      }
    },
    "intakeTransition": {
      "type": "object", "additionalProperties": false,
      "required": ["protocol", "status", "changed_at"],
      "properties": {
        "protocol": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
        "status": {"type": "string", "pattern": "^(in_review|closed)$"},
        "changed_at": {"type": "string", "minLength": 1}
      }
    },
    "updateQueued": {
      "type": "object", "additionalProperties": false,
      "required": ["queued"],
      "properties": { "queued": {"const": true} }
    },
    "intakeServiceTransition": {
      "type": "object", "additionalProperties": false,
      "required": ["seq", "event", "ts"],
      "properties": {
        "seq": {"type": "integer"},
        "event": {"type": "string", "pattern": "^(intake_started|clarification_requested|transaction_confirmed|handoff_created|handoff_accepted|intake_ended)$"},
        "ts": {"type": "string", "minLength": 1},
        "transaction_ref": {"type": "string", "minLength": 1},
        "case_ref": {"type": "string", "minLength": 1},
        "kind": {"type": "string", "pattern": "^(complete|technical|incomplete)$"},
        "tool_status": {"type": "string", "pattern": "^(ok|failed|timeout)$"},
        "accepted_by": {"type": "string", "minLength": 1},
        "outcome": {"type": "string", "pattern": "^(accepted|abandoned|withdrawn|technical_failure|routed)$"},
        "missing": {"type": "array", "items": {"type": "string", "pattern": "^(date|currency|amount|matching_transaction|transaction_disambiguation|customer_confirmation|valid_customer_confirmation)$"}}
      }
    },
    "agentIntakeDetail": {
      "type": "object", "additionalProperties": false,
      "required": ["reference_short", "protocol", "episode_id", "kind", "status", "tool_status", "destination", "priority", "urgency", "accepted_at", "first_opened_at", "reason", "language", "customer_statement", "customer_history", "verified_evidence", "actions_taken", "unresolved_questions", "history", "history_has_more", "model_reading", "scope"],
      "properties": {
        "reference_short": { "type": ["string", "null"], "pattern": "^AR-[0-9ABCDEFGHJKMNPQRSTVWXYZ]{4}-[0-9ABCDEFGHJKMNPQRSTVWXYZ]{4}$" },
        "protocol": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
        "episode_id": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
        "kind": {"type": "string", "pattern": "^(complete|technical|incomplete)$"},
        "status": {"type": "string", "pattern": "^(received|in_review|closed)$"},
        "tool_status": {"type": "string", "pattern": "^(ok|failed|timeout)$"},
        "destination": {"type": "string", "minLength": 1},
        "priority": {"type": "string", "minLength": 1},
        "urgency": {"type": "string", "pattern": "^(normal|high)$"},
        "reason": {"type": ["string", "null"], "pattern": "^(not_mine|duplicate|wrong_amount|cancelled_or_not_received|subscription|card_lost_or_stolen|other)$"},
        "accepted_at": {"type": "string", "minLength": 1},
        "language": {"type": "string", "pattern": "^(es|pt|en)$"},
        "customer_statement": {"type": "string", "minLength": 10, "maxLength": 2000},
        "verified_evidence": {"type": "object", "additionalProperties": false, "required": ["transaction"], "properties": {"transaction": {"type": ["object", "null"], "additionalProperties": false, "required": ["transaction_id", "occurred_at", "source_occurred_at", "merchant_name", "amount", "currency"], "properties": {"transaction_id": {"type": "string", "minLength": 1}, "occurred_at": {"type": ["string", "null"]}, "source_occurred_at": {"type": ["string", "null"]}, "merchant_name": {"type": "string"}, "amount": {"type": "string", "pattern": "^[0-9]+(\\.[0-9]{1,2})?$"}, "currency": {"type": "string", "pattern": "^[A-Z]{3}$"}}}}},
        "actions_taken": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "unresolved_questions": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "history": {"type": "array", "maxItems": 100, "items": {"$ref": "#/$defs/intakeServiceTransition"}},
        "history_has_more": {"type": "boolean"},
        "first_opened_at": {"type": "string", "minLength": 1, "description": "UTC ISO timestamp of the first agent open, stored as epoch-ms INTEGER in D1. API pickup ms = Date.parse(first_opened_at) - Date.parse(accepted_at). In SQL subtract CAST(ROUND((julianday(accepted_at)-2440587.5)*86400000) AS INTEGER) from the stored first_opened_at."},
        "customer_history": {"type": "object", "additionalProperties": false, "required": ["reports", "open", "high_urgency", "last_status", "last_accepted_at", "has_more"], "description": "The same customer's other acknowledged reports in their newest 21 episodes, at most 20 reports and no identifiers. Counts and latest status/time cover this bounded window only. has_more means the raw episode window or report bound is full, so older acknowledged reports may be missing even with reports=0.", "properties": {"has_more": {"type": "boolean"}, "reports": {"type": "integer"}, "open": {"type": "integer"}, "high_urgency": {"type": "integer"}, "last_status": {"type": ["string", "null"], "pattern": "^(received|in_review|closed)$"}, "last_accepted_at": {"type": ["string", "null"], "minLength": 1}}},
        "model_reading": {"type": "object", "additionalProperties": false, "required": ["mode", "model_version", "llm_calls"], "description": "Whether a model read the case in shadow: version and call count only, never its output; it decides nothing.", "properties": {"mode": {"type": "string", "pattern": "^(off|shadow)$"}, "model_version": {"type": ["string", "null"], "minLength": 1}, "llm_calls": {"type": "integer"}}},
        "scope": {"const": "synthetic_demo_only"}
      }
    }
  }
}
